{
  "version": 2,
  "builds": [
    {
      "src": "FrontEnd/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/(food-items|voice|update-quantity|login|signup|logout|orders|create-order|verify-payment|user-orders|update-order-status|session-cart)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/FrontEnd/$1"
    }
  ]
}
